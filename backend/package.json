{
  "name": "@charan-interiors/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "SANDBOX_MODE=unsafe-local tsx --test 'src/**/*.test.ts'",
    "e2e:skills": "tsx src/domains/skills/scripts/runLiveSkillsE2E.ts",
    "test:byok-live": "tsx scripts/runByokLiveMatrix.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@charan-interiors/contracts": "*",
    "@google/genai": "^2.31.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
