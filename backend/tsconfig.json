{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./dist",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@charan-interiors/contracts": ["./contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "references": [
    {
      "path": "./contracts"
    }
  ]
}
