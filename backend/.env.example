# Port to bind backend Express server
PORT=3000

# Runtime environment (development, test, production)
NODE_ENV=development

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Supabase Auth token validation. The publishable key is safe to use in the
# browser; server-only secrets below must never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key for upload routes (never use a VITE_ prefix).
SUPABASE_SECRET_KEY=

# Persistent PostgreSQL connection. Use the Supabase transaction-pooler URI in production.
DATABASE_URL=

# Optional PEM override for the bundled Supabase CA certificate.
DATABASE_SSL_CA=

# Google OAuth client used by the Google Drive/Gmail integration.
GOOGLE_CLIENT_ID=

# Optional: enables server-side Gemini processing for scanned PDFs and images.
# Local chat uses the provider key entered by the user in the app.
GEMINI_API_KEY=""
