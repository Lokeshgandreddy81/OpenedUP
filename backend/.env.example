# Port to bind backend Express server
PORT=3000

# Runtime environment (development, test, production)
NODE_ENV=development

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# GEMINI_API_KEY: Required for Gemini AI vision OCR and chapter parsing
GEMINI_API_KEY=""

# Optional OpenRouter key for the built-in :free chat models.
OPENROUTER_API_KEY=""
# Allows unauthenticated loopback sessions to use only those free models.
OPENROUTER_FREE_MODELS_ENABLED=false
# Paid/server-owned provider keys remain sign-in gated by default.
ALLOW_SERVER_PROVIDER_KEYS=false

# Optional Firebase Service Account credentials path
FIREBASE_CONFIG_PATH=""
