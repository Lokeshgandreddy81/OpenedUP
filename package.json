{
  "name": "charan-interiors-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise monorepo for Charan Interiors and Openedup spend analytics",
  "workspaces": [
    "apps/expense-receipts-analytics"
  ],
  "scripts": {
    "dev": "npm run --workspace=@charan-interiors/expense-receipts-analytics dev",
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "test:coverage": "npm run --workspaces --if-present test:coverage",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "lint:fix": "npm run --workspaces --if-present lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "e2e": "npm run --workspace=@charan-interiors/expense-receipts-analytics e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.5.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "braces": "^3.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
