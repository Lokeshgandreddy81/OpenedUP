{
  "name": "charan-interiors-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise monorepo for Charan Interiors and Openedup spend analytics",
  "workspaces": [
    "packages/contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm run --workspace=@charan-interiors/frontend dev",
    "dev:backend": "npm run --workspace=@charan-interiors/backend dev",
    "dev": "node packages/scripts/dev.mjs",
    "build": "npm run --workspaces --if-present build",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run --workspace=@charan-interiors/contracts build && npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "start": "npm run build && npm run --workspace=backend start",
    "e2e:skills": "npm run --workspace=@charan-interiors/backend e2e:skills",
    "check:feature-boundaries": "node frontend/scripts/check-feature-boundaries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.5.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "braces": "^3.0.3",
    "@vercel/oidc": "4.0.4",
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=10.0.0"
  }
}
