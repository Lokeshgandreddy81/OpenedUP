{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@charan-interiors/contracts": [
        "../backend/contracts/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true,
    "baseUrl": "."
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "../backend/contracts"
    }
  ]
}
