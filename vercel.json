{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run --workspace=@charan-interiors/contracts build && npm run --workspace=@charan-interiors/frontend build",
      "outputDirectory": "frontend/dist"
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "backend/src/index.ts",
      "installCommand": "npm ci",
      "buildCommand": "npm run --workspace=@charan-interiors/contracts build && npm run --workspace=@charan-interiors/backend build"
    }
  },
  "rewrites": [
    {
      "source": "/healthz",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
