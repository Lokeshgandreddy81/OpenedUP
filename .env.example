# Firebase project ID must match frontend/firebase-applet-config.json.
FIREBASE_PROJECT_ID=makersuite-showcase

# Persisted account BYOK credentials are encrypted with AES-256-GCM.
# Generate a random 32-byte key, base64 encoded (example: openssl rand -base64 32).
BYOK_ENCRYPTION_KEY=

# Optional server-owned default provider key.
GEMINI_API_KEY=

# Server-owned provider keys are available only to signed-in users and only
# when this is explicitly enabled. BYOK keys do not require this setting.
ALLOW_SERVER_PROVIDER_KEYS=false

# Allows the two built-in OpenRouter :free models to use OPENROUTER_API_KEY
# from unauthenticated localhost sessions. It does not enable paid models or
# accept unauthenticated requests from remote clients.
OPENROUTER_FREE_MODELS_ENABLED=false
OPENROUTER_API_KEY=
