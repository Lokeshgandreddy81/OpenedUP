# Supabase project URL and publishable key (the publishable key is safe for
# browser use when Row Level Security is enabled for exposed tables).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key for the backend (never use a VITE_ prefix).
SUPABASE_SECRET_KEY=

# Planned PostgreSQL connection; the backend does not use this yet.
DATABASE_URL=

# Google OAuth client used by Drive/Gmail workspace authorization.
GOOGLE_CLIENT_ID=

# Persisted account BYOK credentials are encrypted with AES-256-GCM.
# Generate a random 32-byte key, base64 encoded (example: openssl rand -base64 32).
BYOK_ENCRYPTION_KEY=

# Used for server-side Gemini vision/document processing. Chat always requires
# the user's own provider key.
GEMINI_API_KEY=
